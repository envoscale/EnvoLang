// The x86-64 backend at -O0. Follows Stage 1's bootstrap/stage1/x64/gen.envol, so
// `envoc build` writes the same bytes as `envoc1 build`: every SSA value lives in its own
// rbp slot; each instruction loads its operands into fixed registers, computes and stores
// its result. Values are kept canonical (sign- or zero-extended to 64 bits), so overflow
// checks are the CPU flags for 64-bit types and "does it survive re-normalization" for
// narrower ones.
namespace envoc.x64;

use envoc.util;
use envoc.diag;
use envoc.eir;

const u64 TRAP_OVERFLOW = 0;
const u64 TRAP_BOUNDS = 1;
const u64 TRAP_DIVISION = 2;
const u64 TRAP_SHIFT = 4;
const u64 TRAP_UNREACHABLE = 5;
const u64 TRAP_UTF8 = 6;

void Bug(str msg) => ToolFail(msg, EXIT_INTERNAL);

// At -O2, values recomputed where they are used instead of kept (D20).
const u8 REMAT_CONST = 1;      // const: the immediate
const u8 REMAT_FRAME = 2;      // slot: rbp + the offset
const u8 REMAT_LABEL = 3;      // addr: the label's address
const u64 SMALL_BYTES = 256;
const u32 NO_SPILL = 0xFFFFFFFF;
const u64 NOT_SMALL = 0xFFFFFFFFFFFFFFFF;
// The largest frame: displacements from rbp are 32-bit.
const u64 FRAME_MAX = 0x7FFF0000;
const u32 NOLOC = 0xFFFFFFFF;       // Resolve: a value with no place of its own
const u32 PHYS = 0xFFFFFF00;        // Resolve: a source that is a register, PHYS | r
const u32 SLOT = 0x100;             // a place: SLOT + a value's index is its stack slot

struct Gen {
    Asm A;
    u32 Target;
    List<u32> FuncLabels;   // per function
    List<u32> GlobalLabels; // per global
    List<u32> BlockLabels;  // per block (module-wide index)
    List<u32> Traps;        // per panic reason: the shared stub's label, 0 until used
    u32 Func;               // the function being generated
    u32 FirstValue;
    u32 NParams;
    WinImports Imports;
    bool Opt;               // -O2: registers and rematerialization (regalloc.envol)
    List<u8> Regs;          // per value of the function: its register, or NOREG
    List<u32> SpillIdx;     // -O2: per value kept in memory, its stack slot's index (else NO_SPILL)
    List<u32> KeepInst;     // -O2: calls around which a value's caller-saved register is stored
    List<u32> KeepVal;      // and loaded (regalloc.envol), sorted by instruction
    u32 NSpill;             // -O2: how many such slots
    List<u8> RematKind;     // per value of the function: REMAT_*, or 0
    List<u64> RematImm;
    List<bool> Saved;       // the callee-saved registers the function uses (AllocReg order)
    u32 SaveArea;           // their bytes, just below the saved rbp
    // -O2: no frame pointer. The frame is addressed from rsp; offsets are written from
    // where rbp would be (the return address - 8), so an access adds FrameBias, and while
    // a call's stack arguments are reserved, RspDelta
    i32 FrameBias;
    u32 FrameSize;          // -O2: rsp's distance below the saved registers
    u32 SlotBytes;          // -O2: the slots' bytes, above the values' spill slots
    i32 RspDelta;
    List<u32> Uses;         // -O2: per value of the function, how many operands use it
    u32 NextBlock;          // the block emitted next (0 at the function's end): a jump there falls through
    u32 BlockEnd;           // one past the current block's last instruction
    u32 Fused;              // -O2: a compare left for the branch after it to do, or 0
    u32 FoldedField;        // -O2: a field or element address left for the load or store after it, or 0
    u32 FoldedInst;         // its instruction
    // -O2: the value last stored to its stack slot, the register it came from, and the
    // code offset just after: a load of it right there reads the register instead
    u32 SpillV;
    u8 SpillReg;
    usize SpillAt;

    // ------------------------------------------------------------------ helpers

    // The register frame offsets (from rbp's place) are relative to, and the displacement
    // for offset off.
    u8 FB(in this) {
        if (this.Opt) return RSP;
        return RBP;
    }

    i32 FD(in this, i32 off) {
        if (this.Opt) return off + this.FrameBias + this.RspDelta;
        return off;
    }

    // rsp moves down n bytes (a call's stack arguments) or back up.
    void RspDown(ref this, i32 n) {
        this.A.AluImm(5, RSP, n);
        this.RspDelta += n;
    }

    void RspUp(ref this, i32 n) {
        this.A.AluImm(0, RSP, n);
        this.RspDelta -= n;
    }

    // The rbp offset of value v: parameters are the caller's argument slots, others are
    // below the frame pointer.
    i32 VOff(in this, u32 v) {
        u32 k = v - this.FirstValue;
        if (k < this.NParams && !this.Opt) return (16 + 8 * k) as i32;
        if (k < this.NParams && k >= NARGREGS) return (16 + 8 * (k - NARGREGS)) as i32;
        if (this.Opt) {
            // -O2: only values kept in memory have a slot
            u32 idx = this.SpillIdx.Get(k as usize);
            if (idx == NO_SPILL) Bug("x64: a value in a register has no stack slot");
            return 0 - (this.SaveArea + this.SlotBytes + 8 * (idx + 1)) as i32;
        }
        return 0 - (this.SaveArea + 8 * (k + 1)) as i32;
    }

    void LoadV(ref this, u8 r, u32 v) {
        if (this.Opt) {
            usize k = (v - this.FirstValue) as usize;
            u8 rk = this.RematKind.Get(k);
            if (rk == REMAT_CONST) {
                this.A.MovRI(r, this.RematImm.Get(k));
                return;
            }
            if (rk == REMAT_FRAME) {
                this.A.LeaRM(r, this.FB(), this.FD(this.RematImm.Get(k) as i32));
                return;
            }
            if (rk == REMAT_LABEL) {
                this.A.LeaLabel(r, this.RematImm.Get(k) as u32);
                return;
            }
            u8 reg = this.Regs.Get(k);
            if (reg != NOREG) {
                if (reg != r) this.A.MovRR(r, reg);
                return;
            }
        }
        i32 off = this.VOff(v);
        // just stored from a register, with no code or label since: that register has it
        if (this.Opt && v == this.SpillV && this.A.Code.Len() == this.SpillAt && this.A.LastBind < this.SpillAt) {
            if (r != this.SpillReg) this.A.MovRR(r, this.SpillReg);
            return;
        }
        this.A.Load(r, this.FB(), this.FD(off), 8, false);
    }

    void StoreV(ref this, u32 v, u8 r) {
        if (this.Opt) {
            u8 reg = this.Regs.Get((v - this.FirstValue) as usize);
            if (reg != NOREG) {
                if (reg != r) this.A.MovRR(reg, r);
                return;
            }
        }
        i32 off = this.VOff(v);
        this.A.Store(this.FB(), this.FD(off), r, 8);
        if (this.Opt) {
            this.SpillV = v;
            this.SpillReg = r;
            this.SpillAt = this.A.Code.Len();
        }
    }

    // The value of operand o (a value or an integer) into register r.
    void LoadOp(ref this, in Module m, u8 r, u32 o) {
        EOp op = m.Op(o);
        if (op.Kind == OK_VALUE) this.LoadV(r, op.Ref);
        else this.A.MovRI(r, op.Int);
    }

    // -O2: is operand o a constant that fits a sign-extended 32-bit immediate? Sets imm.
    bool SmallImm(in this, in Module m, u32 o, ref i32 imm) {
        if (!this.Opt) return false;
        EOp op = m.Op(o);
        u64 v = 0;
        if (op.Kind == OK_INT) {
            v = op.Int;
        } else if (op.Kind == OK_VALUE) {
            usize k = (op.Ref - this.FirstValue) as usize;
            if (this.RematKind.Get(k) != REMAT_CONST) return false;
            v = this.RematImm.Get(k);
        } else {
            return false;
        }
        i64 s = v as i64;
        if (s < -2147483648 || s > 2147483647) return false;
        imm = s as i32;
        return true;
    }

    // -O2: where operand o (an address) can be read from without a move: its register, or
    // rbp for a slot; else it is loaded into scratch. Sets disp.
    u8 AddrOf(ref this, in Module m, u32 o, u8 scratch, ref i32 disp) {
        disp = 0;
        EOp op = m.Op(o);
        if (this.Opt && op.Kind == OK_VALUE && op.Ref == this.FoldedField && this.FoldedField != 0) {
            // a field address folded into this access: [base + offset]
            EInst fi = m.Inst(this.FoldedInst);
            this.FoldedField = 0;
            i32 inner = 0;
            u8 rb = this.AddrOf(m, fi.FirstOp, scratch, ref inner);
            if (fi.Op == OP_FIELDADDR_X) {
                disp = inner + m.FieldOffset(fi.Ty, fi.Imm as u32) as i32;
                return rb;
            }
            // elemaddr: [base + index * size]; an index that is a constant is a displacement
            u32 size = m.Ty(fi.Ty).Size;
            i32 imm = 0;
            if (this.SmallImm(m, fi.FirstOp + 1, ref imm) && (imm as i64) * (size as i64) < 0x40000000 && (imm as i64) * (size as i64) > -0x40000000) {
                disp = inner + imm * size as i32;
                return rb;
            }
            u8 ri = this.InReg(m, fi.FirstOp + 1, RDX);
            disp = inner;
            this.A.Idx = ri;
            this.A.Scale = ScaleShift(size);
            return rb;
        }
        if (this.Opt && op.Kind == OK_VALUE) {
            usize k = (op.Ref - this.FirstValue) as usize;
            if (this.RematKind.Get(k) == REMAT_FRAME) {
                disp = this.FD(this.RematImm.Get(k) as i32);
                return this.FB();
            }
            if (this.RematKind.Get(k) == 0) {
                u8 reg = this.Regs.Get(k);
                if (reg != NOREG) return reg;
            }
        }
        this.LoadOp(m, scratch, o);
        return scratch;
    }

    // cmp ra, operand o: an immediate where it fits, its register where it has one.
    void CmpOp(ref this, in Module m, u8 ra, u32 o) {
        i32 imm = 0;
        if (this.SmallImm(m, o, ref imm)) {
            this.A.AluImm(7, ra, imm);
            return;
        }
        u8 rb = this.RegOf(m, o);
        if (rb == NOREG) {
            this.LoadOp(m, RCX, o);
            rb = RCX;
        }
        this.A.Alu(ALU_CMP, ra, rb);
    }

    // -O2: the register operand o's value lives in, or NOREG.
    u8 RegOf(in this, in Module m, u32 o) {
        if (!this.Opt) return NOREG;
        EOp op = m.Op(o);
        if (op.Kind != OK_VALUE) return NOREG;
        usize k = (op.Ref - this.FirstValue) as usize;
        if (this.RematKind.Get(k) != 0) return NOREG;
        return this.Regs.Get(k);
    }

    // -O2: the register to compute value v in: its own, else rax (then stored).
    u8 DestReg(in this, u32 v) {
        if (!this.Opt) return RAX;
        usize k = (v - this.FirstValue) as usize;
        if (this.RematKind.Get(k) != 0) return RAX;
        u8 r = this.Regs.Get(k);
        if (r == NOREG) return RAX;
        return r;
    }

    // Operand o in a register: its own, or loaded into scratch.
    u8 InReg(ref this, in Module m, u32 o, u8 scratch) {
        u8 r = this.RegOf(m, o);
        if (r != NOREG) return r;
        this.LoadOp(m, scratch, o);
        return scratch;
    }

    // -O2: add, sub, and, or, xor and wrapping mul computed in the result's register, with
    // the second operand from its register or as an immediate.
    void FastAlu(ref this, in Module m, in EInst inst, u16 op, u32 size, bool signed) {
        u32 f = inst.FirstOp;
        u8 d = this.DestReg(inst.Result);
        i32 imm = 0;
        bool isImm = op != 7 && this.SmallImm(m, f + 1, ref imm);
        u8 rb = NOREG;
        if (!isImm) {
            rb = this.RegOf(m, f + 1);
            if (rb == d) d = RAX;
            if (rb == NOREG) {
                this.LoadOp(m, RCX, f + 1);
                rb = RCX;
            }
        }
        this.LoadOp(m, d, f);
        u8 ext = 0;
        u8 code = ALU_ADD;
        if (op == 6 || op == 9) {
            ext = 5;
            code = ALU_SUB;
        } else if (op == 14) {
            ext = 4;
            code = ALU_AND;
        } else if (op == 15) {
            ext = 1;
            code = ALU_OR;
        } else if (op == 16) {
            ext = 6;
            code = ALU_XOR;
        }
        // 32-bit add and sub: the flags check them, and the result is already normal
        bool wide32 = size == 4 && op != 7 && op <= 9;
        if (op == 7) this.A.ImulRR(d, rb);
        else if (op == 16 && isImm && imm == -1 && size == 8) this.A.Group3(2, d);       // not
        else if (wide32 && isImm) this.A.AluImm32(ext, d, imm);
        else if (wide32) this.A.Alu32(code, d, rb);
        else if (isImm) this.A.AluImm(ext, d, imm);
        else this.A.Alu(code, d, rb);
        if (op == 8 || op == 9) {
            if (size == 8 || wide32) {
                u32 ovTrap = this.TrapLabel(TRAP_OVERFLOW);
                if (signed) this.A.Jcc(CC_O, ovTrap);
                else this.A.Jcc(CC_B, ovTrap);
                if (wide32 && signed) this.A.Extend(d, 4, true);
            } else {
                this.CheckNormal(m, d, inst.Ty);
            }
        } else if (op >= 14 && op <= 16) {
            // and, or, xor of normal values are normal
        } else if (wide32) {
            if (signed) this.A.Extend(d, 4, true);
        } else if (inst.Ty != ET_BOOL) {
            this.A.Extend(d, size, signed);
        }
        this.StoreV(inst.Result, d);
    }

    // -O2: unsigned x / d or x % d for a constant d > 1, without a division: a shift and a
    // mask for a power of two, else a multiply by d's reciprocal (Granlund and Montgomery:
    // l = ceil(log2 d), m = floor(2^64 (2^l - d) / d) + 1, q = (t + ((x - t) >> 1)) >> (l - 1)
    // with t = the high half of m * x). x is in rax and the divisor in rcx; leaves the
    // result in rax. False (nothing emitted) if the divisor is not such a constant.
    // -O2: is the divisor of inst a constant UnsignedDivConst handles?
    bool DivisorConst(in this, in Module m, in EInst inst) {
        if (!this.Opt) return false;
        EOp dop = m.Op(inst.FirstOp + 1);
        u64 d = 0;
        if (dop.Kind == OK_INT) {
            d = dop.Int;
        } else if (dop.Kind == OK_VALUE) {
            usize k = (dop.Ref - this.FirstValue) as usize;
            if (this.RematKind.Get(k) != REMAT_CONST) return false;
            d = this.RematImm.Get(k);
        } else {
            return false;
        }
        return d >= 2 && d <= 0x8000000000000000;
    }

    bool UnsignedDivConst(ref this, in Module m, in EInst inst, u16 op) {
        if (!this.Opt) return false;
        EOp dop = m.Op(inst.FirstOp + 1);
        u64 d = 0;
        if (dop.Kind == OK_INT) {
            d = dop.Int;
        } else if (dop.Kind == OK_VALUE) {
            usize k = (dop.Ref - this.FirstValue) as usize;
            if (this.RematKind.Get(k) != REMAT_CONST) return false;
            d = this.RematImm.Get(k);
        } else {
            return false;
        }
        if (d < 2 || d > 0x8000000000000000) return false;
        u8 l = 0;
        while (l < 63 && ((1 as u64) << l as u64) < d) l++;
        if (d & (d - 1) == 0) {
            if (op == 12) {
                this.A.ShiftImm(5, RAX, l);
            } else {
                this.A.MovRI(RCX, d - 1);
                this.A.Alu(ALU_AND, RAX, RCX);
            }
            return true;
        }
        // the short form when d allows it: q = (x * m) >> 64 >> s with m = ceil(2^(64+s) / d),
        // which is exact for every x when m * d - 2^(64+s) <= 2^s
        for (u8 s = 0; s < l; s++) {
            u64 r = (1 as u64) << s as u64;     // below d, so the quotient fits 64 bits
            u64 fq = 0;
            for (u32 i = 0; i < 64; i++) {
                bool top = r >> 63 != 0;
                r = r << 1;
                fq = fq << 1;
                if (top || r >= d) {
                    r = r -% d;
                    fq = fq | 1;
                }
            }
            if (r == 0 || fq == 0xFFFFFFFFFFFFFFFF || d - r > ((1 as u64) << s as u64)) continue;
            this.A.MovRR(RCX, RAX);             // x
            this.A.MovRI(RAX, fq + 1);
            this.A.Group3(4, RCX);              // mul rcx: the high half in rdx
            this.A.MovRR(RAX, RDX);
            if (s > 0) this.A.ShiftImm(5, RAX, s);
            if (op == 13) {
                this.A.MovRI(RDX, d);
                this.A.ImulRR(RAX, RDX);
                this.A.Alu(ALU_SUB, RCX, RAX);
                this.A.MovRR(RAX, RCX);
            }
            return true;
        }
        // m: 2^64 (2^l - d) / d by long division; the high half 2^l - d is below d
        u64 rem = ((1 as u64) << l as u64) -% d;
        u64 q = 0;
        for (u32 i = 0; i < 64; i++) {
            bool carry = rem >> 63 != 0;
            rem = rem << 1;
            q = q << 1;
            if (carry || rem >= d) {
                rem = rem -% d;
                q = q | 1;
            }
        }
        u64 magic = q +% 1;
        this.A.MovRR(RCX, RAX);             // x
        this.A.MovRI(RAX, magic);
        this.A.Group3(4, RCX);              // mul rcx: t in rdx
        this.A.MovRR(RAX, RCX);
        this.A.Alu(ALU_SUB, RAX, RDX);
        this.A.ShiftImm(5, RAX, 1);
        this.A.Alu(ALU_ADD, RAX, RDX);
        if (l > 1) this.A.ShiftImm(5, RAX, l - 1);
        if (op == 13) {
            // x - q * d
            this.A.MovRI(RDX, d);
            this.A.ImulRR(RAX, RDX);
            this.A.Alu(ALU_SUB, RCX, RAX);
            this.A.MovRR(RAX, RCX);
        }
        return true;
    }

    // -O2: a switch with at least 4 cases whose keys are dense becomes an indexed jump
    // through a table of the cases' stubs (each moves its target's arguments and jumps).
    // False (nothing emitted) for a sparse switch, which stays a chain of compares.
    bool JumpTable(ref this, in Module m, in EInst inst) {
        u32 f = inst.FirstOp;
        u32 n = inst.NOps;
        u32 count = (n - 2) / 2;
        if (count < 4) return false;
        u64 lo = m.Op(f + 1).Int;
        u64 hi = lo;
        for (u32 k = 1; k + 1 < n; k += 2) {
            u64 key = m.Op(f + k).Int;
            if ((key as i64) < (lo as i64)) lo = key;
            if ((key as i64) > (hi as i64)) hi = key;
        }
        u64 range = hi -% lo;
        if (range > 4096 || range > 3 * count as u64 + 8) return false;
        u32 table = this.A.NewLabel();
        u32 fallback = this.A.NewLabel();
        List<u32> stubs = List<u32>.New();      // per case
        for (u32 c = 0; c < count; c++) stubs.Push(this.A.NewLabel());
        this.LoadOp(m, RAX, f);
        if (lo != 0) {
            this.A.MovRI(RCX, lo);
            this.A.Alu(ALU_SUB, RAX, RCX);
        }
        this.A.MovRI(RCX, range);
        this.A.Alu(ALU_CMP, RAX, RCX);
        this.A.Jcc(CC_A, fallback);
        this.A.LeaLabel(R11, table);
        this.A.ShiftImm(4, RAX, 3);
        this.A.Alu(ALU_ADD, R11, RAX);
        this.A.Load(RAX, R11, 0, 8, false);
        this.A.JmpR(RAX);
        for (u32 c = 0; c < count; c++) {
            this.A.Bind(stubs.Get(c as usize));
            this.Jump(m, f + 2 + 2 * c, false);
        }
        this.A.Bind(fallback);
        this.Jump(m, f + n - 1, true);
        // the table: for each key from lo to hi, its case's stub (the first case with that
        // key, as the compare chain would take), else the default's
        this.A.DataAlign(8);
        this.A.BindData(table);
        for (u64 key = 0; key <= range; key++) {
            u32 target = fallback;
            for (u32 c = count; c > 0; c--) {
                if (m.Op(f + 2 * c - 1).Int -% lo == key) target = stubs.Get((c - 1) as usize);
            }
            this.A.DataAddr(target);
        }
        return true;
    }

    // -O2: is compare i used only by the conditional branch right after it?
    bool FusesWithBranch(in this, in Module m, u32 i, in EInst inst) {
        if (!this.Opt || i + 1 >= this.BlockEnd) return false;
        EInst next = m.Inst(i + 1);
        if (next.Op != 56) return false;
        EOp c = m.Op(next.FirstOp);
        if (c.Kind != OK_VALUE || c.Ref != inst.Result) return false;
        return this.Uses.Get((inst.Result - this.FirstValue) as usize) == 1;
    }

    // -O2: is field address inst (instruction i) used once, as the address of the load or
    // store right after it? Then that access addresses [base + offset] itself.
    bool FoldsIntoAccess(in this, in Module m, u32 i, in EInst inst) {
        if (i + 1 >= this.BlockEnd || this.Uses.Get((inst.Result - this.FirstValue) as usize) != 1) return false;
        EInst next = m.Inst(i + 1);
        u8 sh = OpTable(next.Op).Shape;
        u32 at = 0;
        if (sh == SH_LOAD) at = next.FirstOp;
        else if (sh == SH_STORE) at = next.FirstOp + 1;
        else return false;
        EOp a = m.Op(at);
        return a.Kind == OK_VALUE && a.Ref == inst.Result;
    }

    // The label of the shared stub that panics with reason i.
    u32 TrapLabel(ref this, u64 reason) {
        u32 l = this.Traps.Get(reason as usize);
        if (l == 0) {
            l = this.A.NewLabel();
            this.Traps.Set(reason as usize, l);
        }
        return l;
    }

    // Panics with reason unless r survives re-normalization to type t (narrow types).
    void CheckNormal(ref this, in Module m, u8 r, u32 t) {
        ETy ty = m.Ty(t);
        this.A.MovRR(R11, r);
        this.A.Extend(R11, ty.Size, m.IsSigned(t));
        this.A.Alu(ALU_CMP, R11, r);
        u32 trap = this.TrapLabel(TRAP_OVERFLOW);
        this.A.Jcc(CC_NE, trap);
    }

    u32 FuncNamed(in this, in Module m, str name) {
        u64? named = m.Names.Get(name);
        if (named.IsNone() || named.Unwrap() >> 32 != NAME_FUNC) {
            string b = string.From("x64: the runtime has no function ");
            b.Append(name);
            Bug(b);
        }
        return (named.Unwrap() & 0xFFFFFFFF) as u32;
    }

    // ------------------------------------------------------------------ branches

    // Moves branch target o's arguments into the target block's parameters (a parallel
    // copy) and jumps there. At -O2 the copy is ordered so no place is overwritten before
    // it is read (a cycle goes through r11), a value already where it belongs is not moved,
    // and a last jump to the block emitted next falls through.
    void Jump(ref this, in Module m, u32 o, bool last) {
        EOp op = m.Op(o);
        EBlock target = m.Block(op.Ref);
        if (this.Opt) {
            this.ParallelMove(m, op, target);
        } else {
            for (u32 i = 0; i < op.NArgs; i++) {
                this.LoadV(RAX, m.Arg(op.Args + i));
                this.A.Push(RAX);
            }
            u32 i = op.NArgs;
            while (i > 0) {
                i--;
                this.A.Pop(RAX);
                this.StoreV(target.FirstParam + i, RAX);
            }
        }
        if (this.Opt && last && op.Ref == this.NextBlock) return;
        this.A.Jmp(this.BlockLabels.Get(op.Ref as usize));
    }

    // -O2: where value v lives: its register, SLOT + its index for its stack slot, or
    // NOLOC for a value recomputed where it is used (which nothing overwrites).
    u32 Loc(in this, u32 v) {
        usize k = (v - this.FirstValue) as usize;
        if (this.RematKind.Get(k) != 0) return NOLOC;
        u8 r = this.Regs.Get(k);
        if (r != NOREG) return r as u32;
        return SLOT + k as u32;
    }

    // -O2: does branch op's parallel move do nothing (every argument already in place)?
    bool MovesNothing(in this, in Module m, in EOp op) {
        EBlock target = m.Block(op.Ref);
        for (u32 i = 0; i < op.NArgs; i++) {
            u32 pv = target.FirstParam + i;
            u32 av = m.Arg(op.Args + i);
            if (av == pv || this.Uses.Get((pv - this.FirstValue) as usize) == 0) continue;
            if (this.Loc(pv) != this.SrcLoc(av)) return false;
        }
        return true;
    }

    // -O2: branch op's arguments into target's parameters (unused parameters get nothing).
    void ParallelMove(ref this, in Module m, in EOp op, in EBlock target) {
        List<u32> dst = List<u32>.New();
        List<u32> src = List<u32>.New();
        for (u32 i = 0; i < op.NArgs; i++) {
            u32 pv = target.FirstParam + i;
            u32 av = m.Arg(op.Args + i);
            if (av == pv || this.Uses.Get((pv - this.FirstValue) as usize) == 0) continue;
            dst.Push(this.Loc(pv));
            src.Push(av);
        }
        this.Resolve(dst, ref src);
    }

    // -O2: moves every src[j] (a value, or PHYS | a register) into place dst[j] (a register,
    // or SLOT + a value's index) at once. A move goes once no source still to be read lives
    // in its destination; when every move left waits on another (a cycle), one
    // destination's contents go to r11 and its readers read r11 instead.
    void Resolve(ref this, in List<u32> dst, ref List<u32> src) {
        usize n = dst.Len();
        List<bool> done = List<bool>.New();
        usize left = n;
        for (usize j = 0; j < n; j++) {
            bool here = this.SrcLoc(src.Get(j)) == dst.Get(j);
            done.Push(here);
            if (here) left--;
        }
        while (left > 0) {
            bool progress = false;
            for (usize j = 0; j < n; j++) {
                if (done.Get(j)) continue;
                u32 dl = dst.Get(j);
                bool blocked = false;
                for (usize q = 0; q < n && !blocked; q++) {
                    if (q != j && !done.Get(q) && this.SrcLoc(src.Get(q)) == dl) blocked = true;
                }
                if (blocked) continue;
                this.Put(dl, src.Get(j));
                done.Set(j, true);
                left--;
                progress = true;
            }
            if (!progress) {
                usize j = 0;
                while (done.Get(j)) j++;
                u32 dl = dst.Get(j);
                if (dl < SLOT) this.A.MovRR(R11, dl as u8);
                else this.A.Load(R11, this.FB(), this.FD(this.SlotOff(dl)), 8, false);
                for (usize q = 0; q < n; q++) {
                    if (!done.Get(q) && this.SrcLoc(src.Get(q)) == dl) src.Set(q, PHYS | (R11 as u32));
                }
            }
        }
    }

    u32 SrcLoc(in this, u32 s) {
        if (s >= PHYS && s != NOLOC) return s & 0xFF;
        return this.Loc(s);
    }

    i32 SlotOff(in this, u32 place) => this.VOff(this.FirstValue + place - SLOT);

    // -O2: place dl = source s, by the shortest route.
    void Put(ref this, u32 dl, u32 s) {
        u8 rs = NOREG;
        if (s >= PHYS && s != NOLOC) {
            rs = (s & 0xFF) as u8;
        } else {
            u32 sl = this.Loc(s);
            if (sl < SLOT) rs = sl as u8;
        }
        if (rs != NOREG) {
            if (dl >= SLOT) this.A.Store(this.FB(), this.FD(this.SlotOff(dl)), rs, 8);
            else if (dl != rs as u32) this.A.MovRR(dl as u8, rs);
            return;
        }
        if (dl < SLOT) {
            this.LoadV(dl as u8, s);
            return;
        }
        this.LoadV(RAX, s);
        this.A.Store(this.FB(), this.FD(this.SlotOff(dl)), RAX, 8);
    }

    // ------------------------------------------------------------------ instructions

    void Inst(ref this, in Module m, u32 i) {
        EInst inst = m.Inst(i);
        OpInfo info = OpTable(inst.Op);
        u16 op = inst.Op;
        u8 sh = info.Shape;
        u32 f = inst.FirstOp;
        u32 n = inst.NOps;
        u32 t = inst.Ty;
        ETy ty = m.Ty(t);
        bool signed = m.IsSigned(t);
        i32 storeImm = 0;
        i32 shiftBy = 0;
        if (this.Opt && inst.Result != 0 && this.RematKind.Get((inst.Result - this.FirstValue) as usize) != 0) return;
        if (sh == SH_CONST) {
            this.A.MovRI(RAX, inst.Imm);
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_ADDR) {
            EOp rf = m.Op(f);
            if (rf.Int == NAME_FUNC) this.A.LeaLabel(RAX, this.FuncLabels.Get(rf.Ref as usize));
            else this.A.LeaLabel(RAX, this.GlobalLabels.Get(rf.Ref as usize));
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_SLOT) {
            // the address was computed when the frame was laid out; see Func
            this.A.LeaRM(RAX, this.FB(), this.FD(inst.Imm as i32));
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_UNARY_V) {
            // slot.end: storage is never reused at -O0
        } else if (sh == SH_BIN && m.IsFloat(t)) {
            this.FloatBin(m, inst);
        } else if (sh == SH_CMP && m.IsFloat(t)) {
            this.FloatCmp(m, inst);
        } else if (sh == SH_CONV && op >= 35 && op <= 38) {
            this.FloatConv(m, inst);
        } else if (sh == SH_UN && op == 31) {
            // fneg: flip the sign bit
            this.LoadOp(m, RAX, f);
            if (ty.Size == 8) this.A.MovRI(RCX, 0x8000000000000000);
            else this.A.MovRI(RCX, 0x80000000);
            this.A.Alu(ALU_XOR, RAX, RCX);
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_BIN && this.Opt && (op == 5 || op == 6 || op == 7 || op == 8 || op == 9 || op == 14 || op == 15 || op == 16)) {
            this.FastAlu(m, inst, op, ty.Size, signed);
        } else if (sh == SH_BIN) {
            this.LoadOp(m, RAX, f);
            i32 imm = 0;
            u8 ext = 0xFF;
            if (op == 5 || op == 8) ext = 0;
            else if (op == 6 || op == 9) ext = 5;
            else if (op == 14) ext = 4;
            else if (op == 15) ext = 1;
            else if (op == 16) ext = 6;
            // a shift by a constant in range, or an unsigned division by a constant, does not
            // read the second operand from rcx
            bool noRcx = (op == OP_SHL || op == OP_SHR) && this.Opt && this.SmallImm(m, f + 1, ref shiftBy) && shiftBy >= 0 && shiftBy < (ty.Size * 8) as i32;
            if ((op == 12 || op == 13) && !signed && this.DivisorConst(m, inst)) noRcx = true;
            if (ext != 0xFF && this.SmallImm(m, f + 1, ref imm)) this.A.AluImm(ext, RAX, imm);
            else if (!noRcx) this.LoadOp(m, RCX, f + 1);
            if (ext != 0xFF && this.SmallImm(m, f + 1, ref imm)) {
                // done above, with the immediate
            } else if (op == 5 || op == 8) this.A.Alu(ALU_ADD, RAX, RCX);
            else if (op == 6 || op == 9) this.A.Alu(ALU_SUB, RAX, RCX);
            else if (op == 7) this.A.ImulRR(RAX, RCX);
            else if (op == 10) {
                if (ty.Size == 8 && !signed) this.A.Group3(4, RCX);     // mul rcx: CF/OF if the high half is set
                else this.A.ImulRR(RAX, RCX);
            } else if ((op == 12 || op == 13) && !signed && this.UnsignedDivConst(m, inst, op)) {
                // done: a multiply by the divisor's reciprocal, or a shift
            } else if (op == 12 || op == 13) {
                this.A.TestRR(RCX, RCX);
                u32 divTrap = this.TrapLabel(TRAP_DIVISION);
                this.A.Jcc(CC_E, divTrap);
                if (signed) {
                    if (ty.Size == 8) {
                        // MIN / -1 overflows (and would fault)
                        u32 ok = this.A.NewLabel();
                        this.A.AluImm(7, RCX, -1);
                        this.A.Jcc(CC_NE, ok);
                        this.A.MovRI(RDX, 0x8000000000000000);
                        this.A.Alu(ALU_CMP, RAX, RDX);
                        u32 ovTrap = this.TrapLabel(TRAP_OVERFLOW);
                        this.A.Jcc(CC_E, ovTrap);
                        this.A.Bind(ok);
                    }
                    this.A.Cqo();
                    this.A.Group3(7, RCX);
                } else {
                    this.A.Alu(ALU_XOR, RDX, RDX);
                    this.A.Group3(6, RCX);
                }
                if (op == 13) this.A.MovRR(RAX, RDX);
            } else if (op == 14) this.A.Alu(ALU_AND, RAX, RCX);
            else if (op == 15) this.A.Alu(ALU_OR, RAX, RCX);
            else if (op == 16) this.A.Alu(ALU_XOR, RAX, RCX);
            else if ((op == OP_SHL || op == OP_SHR) && this.Opt && this.SmallImm(m, f + 1, ref shiftBy) && shiftBy >= 0 && shiftBy < (ty.Size * 8) as i32) {
                // a constant amount in range: no check, an immediate shift
                u8 sext = 5;
                if (op == OP_SHL) sext = 4;
                else if (signed) sext = 7;
                this.A.ShiftImm(sext, RAX, shiftBy as u8);
            } else if (op == OP_SHL || op == OP_SHR) {
                if (signed) {
                    this.A.TestRR(RCX, RCX);
                    u32 shTrap = this.TrapLabel(TRAP_SHIFT);
                    this.A.Jcc(CC_L, shTrap);
                }
                this.A.AluImm(7, RCX, (ty.Size * 8) as i32);
                u32 shTrap2 = this.TrapLabel(TRAP_SHIFT);
                this.A.Jcc(CC_AE, shTrap2);
                if (op == OP_SHL) this.A.ShiftCl(4, RAX);
                else if (signed) this.A.ShiftCl(7, RAX);
                else this.A.ShiftCl(5, RAX);
            } else {
                Bug("x64: floating-point instructions are not supported by the -O0 backend");
            }
            // checks and re-normalization
            if (op == 8 || op == 9 || op == 10) {
                if (ty.Size == 8) {
                    u32 ovTrap = this.TrapLabel(TRAP_OVERFLOW);
                    if (signed || op == 10) this.A.Jcc(CC_O, ovTrap);
                    else this.A.Jcc(CC_B, ovTrap);
                } else {
                    this.CheckNormal(m, RAX, t);
                }
            } else if (op == 12) {
                if (ty.Size != 8) this.CheckNormal(m, RAX, t);
            } else if (t != ET_BOOL) {
                this.A.Extend(RAX, ty.Size, signed);
            }
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_UN) {
            this.LoadOp(m, RAX, f);
            if (op == 11) {
                if (signed) {
                    this.A.Group3(3, RAX);
                    if (ty.Size == 8) {
                        u32 ovTrap = this.TrapLabel(TRAP_OVERFLOW);
                        this.A.Jcc(CC_O, ovTrap);
                    } else this.CheckNormal(m, RAX, t);
                } else {
                    this.A.TestRR(RAX, RAX);
                    u32 ovTrap = this.TrapLabel(TRAP_OVERFLOW);
                    this.A.Jcc(CC_NE, ovTrap);
                }
            } else if (op == 17) {
                if (t == ET_BOOL) {
                    this.A.AluImm(6, RAX, 1);       // xor rax, 1
                } else {
                    this.A.Group3(2, RAX);
                    this.A.Extend(RAX, ty.Size, signed);
                }
            } else {
                Bug("x64: floating-point instructions are not supported by the -O0 backend");
            }
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_CMP) {
            if (this.FusesWithBranch(m, i, inst)) {
                this.Fused = inst.Result;
                return;
            }
            if (this.Opt) {
                this.CmpOp(m, this.InReg(m, f, RAX), f + 1);
            } else {
                this.LoadOp(m, RAX, f);
                this.LoadOp(m, RCX, f + 1);
                this.A.Alu(ALU_CMP, RAX, RCX);
            }
            this.A.SetCC(CmpCC(op, signed), RAX);
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_SELECT && this.Opt) {
            // the false value, then the true one over it if the condition holds: no branch
            this.LoadOp(m, RAX, f + 2);
            this.LoadOp(m, RCX, f + 1);
            this.LoadOp(m, R11, f);
            this.A.TestRR(R11, R11);
            this.A.CmovRR(CC_NE, RAX, RCX);
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_SELECT) {
            u32 done = this.A.NewLabel();
            this.LoadOp(m, RAX, f + 1);
            this.LoadOp(m, RCX, f);
            this.A.TestRR(RCX, RCX);
            this.A.Jcc(CC_NE, done);
            this.LoadOp(m, RAX, f + 2);
            this.A.Bind(done);
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_CONV && this.Opt && (op == 32 || op == 33 || op == 34 || op == 41 || op == 39 || op == 40)) {
            u8 d = this.DestReg(inst.Result);
            this.LoadOp(m, d, f);
            ETy to = m.Ty(inst.Ty2);
            bool toSigned = m.IsSigned(inst.Ty2);
            if (op == 32 || op == 41) {
                this.A.Extend(d, to.Size, toSigned);
            } else if (op == 33) {
                // values are kept normal for their type: an unsigned one is zero-extended
                // already, and a widened value stays below the target's sign bit
                if (signed) this.A.Extend(d, ty.Size, false);
            } else if (op == 34) {
                // a signed one is sign-extended already; an unsigned target wants the bits
                // above its size clear
                if (!signed) this.A.Extend(d, ty.Size, true);
                if (!toSigned) this.A.Extend(d, to.Size, false);
            }
            this.StoreV(inst.Result, d);
        } else if (sh == SH_CONV) {
            this.LoadOp(m, RAX, f);
            ETy to = m.Ty(inst.Ty2);
            bool toSigned = m.IsSigned(inst.Ty2);
            if (op == 32 || op == 41) {
                this.A.Extend(RAX, to.Size, toSigned);
            } else if (op == 33) {
                this.A.Extend(RAX, ty.Size, false);
                this.A.Extend(RAX, to.Size, toSigned);
            } else if (op == 34) {
                this.A.Extend(RAX, ty.Size, true);
                this.A.Extend(RAX, to.Size, toSigned);
            } else if (op != 39 && op != 40) {
                Bug("x64: floating-point conversions are not supported by the -O0 backend");
            }
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_LOAD) {
            i32 disp = 0;
            u8 rb = this.AddrOf(m, f, RCX, ref disp);
            u8 d = this.DestReg(inst.Result);
            this.A.Load(d, rb, disp, ty.Size, signed);
            this.A.Idx = NO_INDEX;
            this.StoreV(inst.Result, d);
            return;
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_STORE && this.Opt && this.SmallImm(m, f, ref storeImm)) {
            // a small constant is stored as an immediate
            i32 disp = 0;
            u8 rb = this.AddrOf(m, f + 1, RCX, ref disp);
            this.A.StoreImm(rb, disp, storeImm, ty.Size);
            this.A.Idx = NO_INDEX;
        } else if (sh == SH_STORE) {
            u8 rv = RAX;
            if (this.Opt) rv = this.InReg(m, f, RAX);
            else this.LoadOp(m, RAX, f);
            i32 disp = 0;
            u8 rb = this.AddrOf(m, f + 1, RCX, ref disp);
            this.A.Store(rb, disp, rv, ty.Size);
            this.A.Idx = NO_INDEX;
        } else if (sh == SH_ELEM && this.Opt && ScaleShift(ty.Size) != NO_SCALE) {
            if (this.FoldsIntoAccess(m, i, inst)) {
                this.FoldedField = inst.Result;
                this.FoldedInst = i;
                return;
            }
            // lea d, [base + index * size]
            u8 d = this.DestReg(inst.Result);
            i32 imm = 0;
            if (this.SmallImm(m, f + 1, ref imm) && (imm as i64) * (ty.Size as i64) < 0x40000000 && (imm as i64) * (ty.Size as i64) > -0x40000000) {
                u8 rb = this.InReg(m, f, RAX);
                this.A.LeaRM(d, rb, imm * ty.Size as i32);
            } else {
                u8 rb = this.InReg(m, f, RAX);
                u8 ri = this.InReg(m, f + 1, RCX);
                this.A.Idx = ri;
                this.A.Scale = ScaleShift(ty.Size);
                this.A.LeaRM(d, rb, 0);
                this.A.Idx = NO_INDEX;
            }
            this.StoreV(inst.Result, d);
        } else if (sh == SH_FIELD) {
            u64 foff = m.FieldOffset(t, inst.Imm as u32);
            if (this.Opt && foff < 0x40000000 && this.FoldsIntoAccess(m, i, inst)) {
                this.FoldedField = inst.Result;
                this.FoldedInst = i;
                return;
            }
            if (this.Opt) {
                u8 d = this.DestReg(inst.Result);
                u8 ra = this.RegOf(m, f);
                if (ra != NOREG && foff != 0) {
                    this.A.LeaRM(d, ra, foff as i32);
                } else {
                    this.LoadOp(m, d, f);
                    if (foff != 0) this.A.LeaRM(d, d, foff as i32);
                }
                this.StoreV(inst.Result, d);
                return;
            }
            this.LoadOp(m, RAX, f);
            this.A.LeaRM(RAX, RAX, foff as i32);
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_ELEM) {
            this.LoadOp(m, RAX, f);
            this.LoadOp(m, RCX, f + 1);
            if (!this.Opt || ty.Size != 1) {
                this.A.MovRI(RDX, ty.Size as u64);
                this.A.ImulRR(RCX, RDX);
            }
            this.A.Alu(ALU_ADD, RAX, RCX);
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_PTRADD && this.Opt) {
            u8 d = this.DestReg(inst.Result);
            u8 rb = this.RegOf(m, f + 1);
            if (rb == d) d = RAX;
            if (rb == NOREG) {
                this.LoadOp(m, RCX, f + 1);
                rb = RCX;
            }
            this.LoadOp(m, d, f);
            this.A.Alu(ALU_ADD, d, rb);
            this.StoreV(inst.Result, d);
        } else if (sh == SH_PTRADD) {
            this.LoadOp(m, RAX, f);
            this.LoadOp(m, RCX, f + 1);
            this.A.Alu(ALU_ADD, RAX, RCX);
            this.StoreV(inst.Result, RAX);
        } else if (sh == SH_VALUES) {
            if (op == 47 && this.Opt && this.SmallConst(m, f + 2) != NOT_SMALL) {
                // a small copy through rax, with the addresses where they are (rsi and
                // rdi stay free: regalloc.envol's Clobbers)
                u8 rd = this.InReg(m, f, RCX);
                u8 rs = this.InReg(m, f + 1, RDX);
                this.MoveBytes(rd, 0, rs, 0, this.SmallConst(m, f + 2));
            } else if (op == 48 && this.Opt && this.SmallConst(m, f + 1) != NOT_SMALL) {
                u8 rd = this.InReg(m, f, RCX);
                this.A.Alu(ALU_XOR, RAX, RAX);
                this.ZeroBytes(rd, 0, this.SmallConst(m, f + 1));
            } else if (op == 47) {
                this.LoadOp(m, RDI, f);
                this.LoadOp(m, RSI, f + 1);
                u64 size = this.SmallConst(m, f + 2);
                if (size != NOT_SMALL) {
                    this.MoveBytes(RDI, 0, RSI, 0, size);
                } else {
                    this.LoadOp(m, RCX, f + 2);
                    this.A.RepMovsb();
                }
            } else if (op == 48) {
                this.LoadOp(m, RDI, f);
                u64 size = this.SmallConst(m, f + 1);
                if (size != NOT_SMALL) {
                    this.A.Alu(ALU_XOR, RAX, RAX);
                    this.ZeroBytes(RDI, 0, size);
                } else {
                    this.LoadOp(m, RCX, f + 1);
                    this.A.Alu(ALU_XOR, RAX, RAX);
                    this.A.RepStosb();
                }
            } else if (op == 50) {
                this.LoadOp(m, RAX, f);
                this.LoadOp(m, RCX, f + 1);
                this.LoadOp(m, RDX, f + 2);
                this.A.Alu(ALU_CMP, RAX, RCX);
                u32 b1 = this.TrapLabel(TRAP_BOUNDS);
                this.A.Jcc(CC_A, b1);
                this.A.Alu(ALU_CMP, RCX, RDX);
                u32 b2 = this.TrapLabel(TRAP_BOUNDS);
                this.A.Jcc(CC_A, b2);
            } else {
                u32 ok = this.A.NewLabel();
                this.LoadOp(m, RDX, f);
                this.LoadOp(m, RCX, f + 1);
                this.LoadOp(m, RAX, f + 2);
                this.A.TestRR(RAX, RAX);
                this.A.Jcc(CC_E, ok);
                this.A.Alu(ALU_CMP, RAX, RCX);
                this.A.Jcc(CC_E, ok);
                this.A.Alu(ALU_ADD, RDX, RAX);
                this.A.Load(RDX, RDX, 0, 1, false);
                this.A.AluImm(4, RDX, 0xC0);
                this.A.AluImm(7, RDX, 0x80);
                u32 u8Trap = this.TrapLabel(TRAP_UTF8);
                this.A.Jcc(CC_E, u8Trap);
                this.A.Bind(ok);
            }
        } else if (sh == SH_BOUNDS && this.Opt) {
            u8 ra = this.InReg(m, f, RAX);
            if (signed) {
                this.A.TestRR(ra, ra);
                u32 b1 = this.TrapLabel(TRAP_BOUNDS);
                this.A.Jcc(CC_L, b1);
            }
            this.CmpOp(m, ra, f + 1);
            u32 b2 = this.TrapLabel(TRAP_BOUNDS);
            this.A.Jcc(CC_AE, b2);
        } else if (sh == SH_BOUNDS) {
            this.LoadOp(m, RAX, f);
            this.LoadOp(m, RCX, f + 1);
            if (signed) {
                this.A.TestRR(RAX, RAX);
                u32 b1 = this.TrapLabel(TRAP_BOUNDS);
                this.A.Jcc(CC_L, b1);
            }
            this.A.Alu(ALU_CMP, RAX, RCX);
            u32 b2 = this.TrapLabel(TRAP_BOUNDS);
            this.A.Jcc(CC_AE, b2);
        } else if ((sh == SH_CALL || sh == SH_CALLIND) && this.Opt) {
            // the first NARGREGS arguments in registers, the rest on the stack
            u32 first = 1;
            u32 count = n - 1;
            if (sh == SH_CALLIND) {
                if (inst.Str.Len > 0) Bug("x64: calls with a foreign ABI are not supported by the -O0 backend");
                first = 0;
            }
            u32 stackArgs = 0;
            if (count > NARGREGS) stackArgs = count - NARGREGS;
            i32 reserve = ((8 * stackArgs + 15) & ~15) as i32;
            if (reserve > 0) this.RspDown(reserve);
            for (u32 k = NARGREGS; k < count; k++) {
                u8 ra = this.InReg(m, f + first + k, RAX);
                this.A.Store(RSP, (8 * (k - NARGREGS)) as i32, ra, 8);
            }
            // an argument may sit in an argument register: the target goes to rax first
            // (the moves below use r11 only)
            if (sh == SH_CALLIND) this.LoadOp(m, RAX, f + n - 1);
            List<u32> dst = List<u32>.New();
            List<u32> src = List<u32>.New();
            for (u32 k = 0; k < count && k < NARGREGS; k++) {
                EOp a = m.Op(f + first + k);
                if (a.Kind != OK_VALUE) continue;
                dst.Push(ArgReg(k) as u32);
                src.Push(a.Ref);
            }
            this.Resolve(dst, ref src);
            for (u32 k = 0; k < count && k < NARGREGS; k++) {
                EOp a = m.Op(f + first + k);
                if (a.Kind != OK_VALUE) this.LoadOp(m, ArgReg(k), f + first + k);
            }
            if (sh == SH_CALL) this.A.CallLabel(this.FuncLabels.Get(m.Op(f).Ref as usize));
            else this.A.CallR(RAX);
            if (reserve > 0) this.RspUp(reserve);
            if (inst.Result != 0) this.StoreV(inst.Result, RAX);
        } else if (sh == SH_CALL || sh == SH_CALLIND) {
            u32 first = 1;
            u32 count = n - 1;
            if (sh == SH_CALLIND) {
                if (inst.Str.Len > 0) Bug("x64: calls with a foreign ABI are not supported by the -O0 backend");
                first = 0;
            }
            i32 reserve = ((8 * count + 15) & ~15) as i32;
            if (reserve > 0) this.A.AluImm(5, RSP, reserve);
            for (u32 k = 0; k < count; k++) {
                this.LoadOp(m, RAX, f + first + k);
                this.A.Store(RSP, (8 * k) as i32, RAX, 8);
            }
            if (sh == SH_CALL) {
                this.A.CallLabel(this.FuncLabels.Get(m.Op(f).Ref as usize));
            } else {
                this.LoadOp(m, RAX, f + n - 1);
                this.A.CallR(RAX);
            }
            if (reserve > 0) this.A.AluImm(0, RSP, reserve);
            if (inst.Result != 0) this.StoreV(inst.Result, RAX);
        } else if (sh == SH_INTRINSIC) {
            this.Intrinsic(m, inst);
        } else if (sh == SH_BR) {
            this.Jump(m, f, true);
        } else if (sh == SH_CONDBR) {
            // the condition: a fused compare's flags, or the value tested against zero
            u8 ccTrue = CC_NE;
            EOp c = m.Op(f);
            if (this.Fused != 0 && c.Kind == OK_VALUE && c.Ref == this.Fused) {
                EInst ci = m.Inst(i - 1);
                this.CmpOp(m, this.InReg(m, ci.FirstOp, RAX), ci.FirstOp + 1);
                ccTrue = CmpCC(ci.Op, m.IsSigned(ci.Ty));
                this.Fused = 0;
            } else {
                this.LoadOp(m, RAX, f);
                this.A.TestRR(RAX, RAX);
            }
            EOp yes = m.Op(f + 1);
            EOp no = m.Op(f + 2);
            // an edge whose arguments are already where its block's parameters live moves
            // nothing, so a jcc can take it directly
            bool yesBare = yes.NArgs == 0 || (this.Opt && this.MovesNothing(m, yes));
            bool noBare = no.NArgs == 0 || (this.Opt && this.MovesNothing(m, no));
            if (this.Opt && yesBare && no.Ref == this.NextBlock) {
                // the false side is next: branch on true, fall through
                this.A.Jcc(ccTrue, this.BlockLabels.Get(yes.Ref as usize));
                this.Jump(m, f + 2, true);
            } else if (this.Opt && noBare) {
                this.A.Jcc(ccTrue ^ 1, this.BlockLabels.Get(no.Ref as usize));
                this.Jump(m, f + 1, true);
            } else if (this.Opt && yesBare) {
                this.A.Jcc(ccTrue, this.BlockLabels.Get(yes.Ref as usize));
                this.Jump(m, f + 2, true);
            } else {
                u32 other = this.A.NewLabel();
                this.A.Jcc(ccTrue ^ 1, other);
                this.Jump(m, f + 1, false);
                this.A.Bind(other);
                this.Jump(m, f + 2, true);
            }
        } else if (sh == SH_SWITCH && this.Opt && this.JumpTable(m, inst)) {
            // done: an indexed jump through a table
        } else if (sh == SH_SWITCH) {
            u32 k = 1;
            while (k + 1 < n) {
                u32 next = this.A.NewLabel();
                this.LoadOp(m, RAX, f);
                this.A.MovRI(RCX, m.Op(f + k).Int);
                this.A.Alu(ALU_CMP, RAX, RCX);
                this.A.Jcc(CC_NE, next);
                this.Jump(m, f + k + 1, false);
                this.A.Bind(next);
                k += 2;
            }
            this.Jump(m, f + n - 1, true);
        } else if (sh == SH_RET && this.Opt) {
            // -O2: the frame, then the saved registers
            if (n == 1) this.LoadOp(m, RAX, f);
            if (this.FrameSize > 0) this.A.AluImm(0, RSP, this.FrameSize as i32);
            u32 r = NSAVED;
            while (r > 0) {
                r--;
                if (this.Saved.Get(r as usize)) this.A.Pop(AllocReg(r));
            }
            this.A.RetNear();
        } else if (sh == SH_RET) {
            if (n == 1) this.LoadOp(m, RAX, f);
            if (this.SaveArea > 0) {
                this.A.LeaRM(RSP, RBP, 0 - this.SaveArea as i32);
                u32 r = NSAVED;
                while (r > 0) {
                    r--;
                    if (this.Saved.Get(r as usize)) this.A.Pop(AllocReg(r));
                }
            } else {
                this.A.MovRR(RSP, RBP);
            }
            this.A.Pop(RBP);
            this.A.RetNear();
        } else if (sh == SH_PANIC) {
            u32 trap = this.TrapLabel(inst.Imm);
            this.A.Jmp(trap);
        } else {
            u32 trap = this.TrapLabel(TRAP_UNREACHABLE);
            this.A.Jmp(trap);
        }
    }

    // ------------------------------------------------------------------ floats (RFC 0006)

    // A float's bits live where an integer's do; each operation moves them through xmm0
    // and xmm1. Every NaN a computation makes is the canonical quiet NaN, so results are the
    // same as in WebAssembly and the script runtime (EIR section 5.3).

    // rax = xmm0's bits, with a NaN made canonical.
    void FloatResult(ref this, bool dbl) {
        this.A.MovRX(RAX, 0, dbl);
        this.A.Ucomis(dbl, 0, 0);
        u32 ok = this.A.NewLabel();
        this.A.Jcc(CC_NP, ok);
        if (dbl) this.A.MovRI(RAX, 0x7FF8000000000000);
        else this.A.MovRI(RAX, 0x7FC00000);
        this.A.Bind(ok);
    }

    void FloatBin(ref this, in Module m, EInst inst) {
        u32 f = inst.FirstOp;
        bool dbl = m.Ty(inst.Ty).Size == 8;
        u8 prefix = 0xF3;
        if (dbl) prefix = 0xF2;
        this.LoadOp(m, RAX, f);
        this.LoadOp(m, RCX, f + 1);
        this.A.MovXR(0, RAX, dbl);
        this.A.MovXR(1, RCX, dbl);
        u8 code = 0x58;
        if (inst.Op == 28) code = 0x5C;
        if (inst.Op == 29) code = 0x59;
        if (inst.Op == 30) code = 0x5E;
        this.A.Sse(prefix, code, 0, 1);
        this.FloatResult(dbl);
        this.StoreV(inst.Result, RAX);
    }

    void FloatCmp(ref this, in Module m, EInst inst) {
        u32 f = inst.FirstOp;
        u16 op = inst.Op;
        bool dbl = m.Ty(inst.Ty).Size == 8;
        this.LoadOp(m, RAX, f);
        this.LoadOp(m, RCX, f + 1);
        this.A.MovXR(0, RAX, dbl);
        this.A.MovXR(1, RCX, dbl);
        if (op == 20 || op == 21) {
            this.A.Ucomis(dbl, 0, 1);
            if (op == 20) {
                this.A.SetCC(CC_E, RAX);
                this.A.SetCC(CC_NP, RCX);
                this.A.Alu(ALU_AND, RAX, RCX);
            } else {
                this.A.SetCC(CC_NE, RAX);
                this.A.SetCC(CC_P, RCX);
                this.A.Alu(ALU_OR, RAX, RCX);
            }
        } else if (op == 22 || op == 23) {
            // a < b is b > a; unordered gives false
            this.A.Ucomis(dbl, 1, 0);
            if (op == 22) this.A.SetCC(CC_A, RAX);
            else this.A.SetCC(CC_AE, RAX);
        } else {
            this.A.Ucomis(dbl, 0, 1);
            if (op == 24) this.A.SetCC(CC_A, RAX);
            else this.A.SetCC(CC_AE, RAX);
        }
        this.StoreV(inst.Result, RAX);
    }

    // Conversions with a float on one side: itof, ftoi, fext, ftrunc.
    void FloatConv(ref this, in Module m, EInst inst) {
        u16 op = inst.Op;
        ETy from = m.Ty(inst.Ty);
        ETy to = m.Ty(inst.Ty2);
        this.LoadOp(m, RAX, inst.FirstOp);
        if (op == 37) {
            this.A.MovXR(0, RAX, false);
            this.A.Sse(0xF3, 0x5A, 0, 0);       // cvtss2sd
            this.FloatResult(true);
        } else if (op == 38) {
            this.A.MovXR(0, RAX, true);
            this.A.Sse(0xF2, 0x5A, 0, 0);       // cvtsd2ss
            this.FloatResult(false);
        } else if (op == 35) {
            bool dbl = to.Size == 8;
            u8 prefix = 0xF3;
            if (dbl) prefix = 0xF2;
            if (from.Size == 8 && !m.IsSigned(inst.Ty)) {
                // u64 at 2^63 and above: halve (keeping the low bit for rounding), double
                u32 big = this.A.NewLabel();
                u32 done = this.A.NewLabel();
                this.A.TestRR(RAX, RAX);
                this.A.Jcc(CC_L, big);
                this.A.CvtI2F(prefix, 0, RAX);
                this.A.Jmp(done);
                this.A.Bind(big);
                this.A.MovRR(RDX, RAX);
                this.A.MovRI(RCX, 1);
                this.A.ShiftCl(5, RDX);
                this.A.AluImm(4, RAX, 1);
                this.A.Alu(ALU_OR, RDX, RAX);
                this.A.CvtI2F(prefix, 0, RDX);
                this.A.Sse(prefix, 0x58, 0, 0);
                this.A.Bind(done);
            } else {
                this.A.CvtI2F(prefix, 0, RAX);
            }
            this.A.MovRX(RAX, 0, dbl);
        } else {
            this.FloatToInt(from.Size == 8, to.Size, m.IsSigned(inst.Ty2));
        }
        this.StoreV(inst.Result, RAX);
    }

    // rax (a float's bits) to an integer of size bytes: toward zero, saturating, NaN to 0.
    void FloatToInt(ref this, bool dbl, u32 size, bool signed) {
        this.A.MovXR(0, RAX, dbl);
        if (!dbl) this.A.Sse(0xF3, 0x5A, 0, 0);    // to double: exact
        u32 done = this.A.NewLabel();
        this.A.Ucomis(true, 0, 0);
        this.A.MovRI(RAX, 0);
        this.A.Jcc(CC_P, done);
        if (size == 8 && !signed) {
            this.A.MovRI(RCX, 0x43F0000000000000);     // 2^64
            this.A.MovXR(1, RCX, true);
            this.A.Ucomis(true, 0, 1);
            this.A.MovRI(RAX, 0xFFFFFFFFFFFFFFFF);
            this.A.Jcc(CC_AE, done);
            this.A.MovRI(RCX, 0);
            this.A.MovXR(1, RCX, true);
            this.A.Ucomis(true, 0, 1);
            this.A.MovRI(RAX, 0);
            this.A.Jcc(CC_B, done);
            u32 big = this.A.NewLabel();
            this.A.MovRI(RCX, 0x43E0000000000000);     // 2^63
            this.A.MovXR(1, RCX, true);
            this.A.Ucomis(true, 0, 1);
            this.A.Jcc(CC_AE, big);
            this.A.CvtF2I(0xF2, RAX, 0);
            this.A.Jmp(done);
            this.A.Bind(big);
            this.A.Sse(0xF2, 0x5C, 0, 1);              // subsd
            this.A.CvtF2I(0xF2, RAX, 0);
            this.A.MovRI(RCX, 0x8000000000000000);
            this.A.Alu(ALU_ADD, RAX, RCX);
            this.A.Bind(done);
            return;
        }
        // at 2^63 and above: i64's largest; below -2^63 cvttsd2si gives i64's smallest
        u32 clamp = this.A.NewLabel();
        this.A.MovRI(RCX, 0x43E0000000000000);
        this.A.MovXR(1, RCX, true);
        this.A.Ucomis(true, 0, 1);
        this.A.MovRI(RAX, 0x7FFFFFFFFFFFFFFF);
        this.A.Jcc(CC_AE, clamp);
        this.A.CvtF2I(0xF2, RAX, 0);
        this.A.Bind(clamp);
        if (size < 8 || !signed) {
            u64 hi = 0;
            u64 lo = 0;
            if (signed) {
                hi = (1 << (size as u64 * 8 - 1)) - 1;
                lo = 0 -% (1 << (size as u64 * 8 - 1));
            } else {
                hi = (1 << (size as u64 * 8)) - 1;
            }
            u32 ok1 = this.A.NewLabel();
            this.A.MovRI(RCX, hi);
            this.A.Alu(ALU_CMP, RAX, RCX);
            this.A.Jcc(CC_LE, ok1);
            this.A.MovRR(RAX, RCX);
            this.A.Bind(ok1);
            u32 ok2 = this.A.NewLabel();
            this.A.MovRI(RCX, lo);
            this.A.Alu(ALU_CMP, RAX, RCX);
            this.A.Jcc(CC_GE, ok2);
            this.A.MovRR(RAX, RCX);
            this.A.Bind(ok2);
        }
        this.A.Bind(done);
        this.A.Extend(RAX, size, signed);
    }

    // Target intrinsics: `syscall` on Linux, `wincall` on Windows.
    void Intrinsic(ref this, in Module m, EInst inst) {
        u32 f = inst.FirstOp;
        u32 n = inst.NOps;
        if (TextIs(inst.Str, "syscall")) {
            if (this.Target != TARGET_LINUX) Bug("x64: syscall on a non-Linux target");
            u8[6] regs;
            regs[0] = RDI;
            regs[1] = RSI;
            regs[2] = RDX;
            regs[3] = R10;
            regs[4] = R8;
            regs[5] = R9;
            // all at once: an operand may sit in another's register
            List<u32> dst = List<u32>.New();
            List<u32> src = List<u32>.New();
            for (u32 k = 0; k < n; k++) {
                EOp a = m.Op(f + k);
                if (a.Kind != OK_VALUE || !this.Opt) continue;
                if (k == 0) dst.Push(RAX as u32);
                else dst.Push(regs[k - 1] as u32);
                src.Push(a.Ref);
            }
            if (this.Opt) this.Resolve(dst, ref src);
            for (u32 k = 1; k < n; k++) {
                if (m.Op(f + k).Kind != OK_VALUE || !this.Opt) this.LoadOp(m, regs[k - 1], f + k);
            }
            if (m.Op(f).Kind != OK_VALUE || !this.Opt) this.LoadOp(m, RAX, f);
            this.A.Syscall();
        } else if (TextIs(inst.Str, "wincall") || TextIs(inst.Str, "wincallp")) {
            if (this.Target != TARGET_WINDOWS) Bug("x64: wincall on a non-Windows target");
            bool viaPointer = TextIs(inst.Str, "wincallp");
            u32 args = n - 1;
            u32 stackArgs = 0;
            if (args > 4) stackArgs = args - 4;
            i32 reserve = ((32 + 8 * stackArgs + 15) & ~15) as i32;
            this.RspDown(reserve);
            for (u32 k = 4; k < args; k++) {
                this.LoadOp(m, RAX, f + 1 + k);
                this.A.Store(RSP, (32 + 8 * (k - 4)) as i32, RAX, 8);
            }
            u8[4] regs;
            regs[0] = RCX;
            regs[1] = RDX;
            regs[2] = R8;
            regs[3] = R9;
            // the function pointer or import number into rax, then the register arguments
            // all at once (an operand may sit in another's register; the moves use r11 only)
            this.LoadOp(m, RAX, f);
            List<u32> dst = List<u32>.New();
            List<u32> src = List<u32>.New();
            for (u32 k = 0; k < args && k < 4; k++) {
                EOp a = m.Op(f + 1 + k);
                if (a.Kind != OK_VALUE || !this.Opt) continue;
                dst.Push(regs[k] as u32);
                src.Push(a.Ref);
            }
            if (this.Opt) this.Resolve(dst, ref src);
            for (u32 k = 0; k < args && k < 4; k++) {
                if (m.Op(f + 1 + k).Kind != OK_VALUE || !this.Opt) this.LoadOp(m, regs[k], f + 1 + k);
            }
            if (viaPointer) {
                // the function pointer, in r10 (not an argument register)
                this.A.MovRR(R10, RAX);
            } else {
                // the import's IAT slot: iat + 8 * k, in r10 (not an argument register)
                this.A.LeaLabel(R10, this.Imports.Iat);
                this.A.ShiftImm(4, RAX, 3);
                this.A.Alu(ALU_ADD, R10, RAX);
            }
            if (viaPointer) this.A.CallR(R10);
            else this.A.CallMem(R10);
            this.RspUp(reserve);
        } else {
            Bug("x64: portable intrinsics reach the backend only through the runtime");
        }
        if (inst.Result != 0) this.StoreV(inst.Result, RAX);
    }

    // ------------------------------------------------------------------ functions

    void Func(ref this, ref Module m, u32 fi) {
        EFunc f = m.Func(fi);
        if (f.Extern) Bug("x64: extern functions are not supported by the -O0 backend");
        this.Func = fi;
        this.FirstValue = f.FirstValue;
        this.NParams = f.NParams;
        this.A.Bind(this.FuncLabels.Get(fi as usize));
        // -O2: what to recompute, then registers for the rest
        this.SaveArea = 0;
        this.Saved = List<bool>.New();
        if (this.Opt) this.Plan(m, fi);
        // frame: saved registers, value slots, then the storage of `slot` instructions
        // (zeroed on entry)
        u64 save = this.SaveArea as u64;
        u64 valueArea = 8 * f.NValues as u64;
        if (this.Opt) valueArea = 8 * this.NSpill as u64;
        u64 slotArea = 0;
        EBlock entry = m.Block(f.FirstBlock);
        for (u32 i = entry.FirstInst; i < entry.FirstInst + entry.NInsts; i++) {
            EInst inst = m.Inst(i);
            if (inst.Op != OP_SLOT) break;
            ETy st = m.Ty(inst.Ty);
            u64 align = st.Align as u64;
            if (align < 8) align = 8;
            slotArea = (slotArea + st.Size as u64 + align - 1) & ~(align - 1);
            // rbp offset of the storage; at -O2 the slots come first, so the values' spill
            // slots are the ones next to rsp, in reach of one-byte displacements
            if (this.Opt) inst.Imm = 0 -% (save + slotArea);
            else inst.Imm = 0 -% (save + valueArea + slotArea);
            m.Insts.Set(i as usize, inst);
            if (this.Opt) this.RematImm.Set((inst.Result - f.FirstValue) as usize, inst.Imm);
        }
        u64 frame = ((save + valueArea + slotArea + 15) & ~15) - save;
        this.SlotBytes = slotArea as u32;
        if (this.Opt) {
            // no frame pointer: below the saved registers, the frame (offsets count from the
            // return address - 8, where rbp would be), rsp 16-aligned below it
            frame = 8 + valueArea + slotArea;
            if ((save + frame) % 16 != 8) frame += 8;
            // a function that keeps nothing in its frame and calls nothing needs none
            bool calls = false;
            for (u32 b = f.FirstBlock; b < f.FirstBlock + f.NBlocks && !calls; b++) {
                EBlock cb = m.Block(b);
                for (u32 i = cb.FirstInst; i < cb.FirstInst + cb.NInsts; i++) {
                    u16 cop = m.Inst(i).Op;
                    if (cop == 52 || cop == 53 || cop == 54) calls = true;
                }
            }
            if (valueArea + slotArea == 0 && !calls) frame = 0;
        }
        if (save + frame > FRAME_MAX) ToolFail("a function's locals take more than 2 GiB of stack", EXIT_ERRORS);
        if (!this.Opt) {
            this.A.Push(RBP);
            this.A.MovRR(RBP, RSP);
        }
        for (u32 r = 0; r < this.Saved.Len() as u32 && r < NSAVED; r++) {
            if (this.Saved.Get(r as usize)) this.A.Push(AllocReg(r));
        }
        this.FrameBias = (save + frame) as i32 - 8;
        this.FrameSize = frame as u32;
        this.RspDelta = 0;
        this.ReserveFrame(frame);
        if (slotArea > 0 && this.Opt) {
            // only the slots something may read before writing all of them (frame.envol)
            List<bool> zero = SlotsToZero(m, fi);
            bool cleared = false;
            bool kept = false;
            for (u32 i = entry.FirstInst; i < entry.FirstInst + entry.NInsts; i++) {
                EInst inst = m.Inst(i);
                if (inst.Op != OP_SLOT) break;
                if (!zero.Get((inst.Result - f.FirstValue) as usize)) continue;
                u64 size = m.Ty(inst.Ty).Size as u64;
                if (size == 0) continue;
                if (!cleared) {
                    this.A.Alu(ALU_XOR, RAX, RAX);
                    cleared = true;
                }
                if (size <= SMALL_BYTES) {
                    this.ZeroBytes(this.FB(), this.FD(inst.Imm as i32), size);
                } else {
                    if (!kept && f.NParams > 0) {
                        this.A.MovRR(R11, RDI);
                        kept = true;
                    }
                    this.A.LeaRM(RDI, this.FB(), this.FD(inst.Imm as i32));
                    this.A.MovRI(RCX, size);
                    this.A.RepStosb();
                }
            }
            if (kept) this.A.MovRR(RDI, R11);
        } else if (slotArea > 0) {
            bool keep = this.Opt && f.NParams > 0;
            if (keep) this.A.MovRR(R11, RDI);
            this.A.LeaRM(RDI, RBP, (0 -% (save + valueArea + slotArea)) as i32);
            this.A.MovRI(RCX, slotArea);
            this.A.Alu(ALU_XOR, RAX, RAX);
            this.A.RepStosb();
            if (keep) this.A.MovRR(RDI, R11);
        }
        if (this.Opt) {
            // the register arguments into their places, then the stack ones
            List<u32> dst = List<u32>.New();
            List<u32> src = List<u32>.New();
            for (u32 k = 0; k < f.NParams && k < NARGREGS; k++) {
                if (this.Uses.Get(k as usize) == 0) continue;
                dst.Push(this.Loc(f.FirstValue + k));
                src.Push(PHYS | (ArgReg(k) as u32));
            }
            this.Resolve(dst, ref src);
            for (u32 k = NARGREGS; k < f.NParams; k++) {
                u8 reg = this.Regs.Get(k as usize);
                if (reg != NOREG) this.A.Load(reg, this.FB(), this.FD((16 + 8 * (k - NARGREGS)) as i32), 8, false);
            }
        }
        this.Fused = 0;
        this.FoldedField = 0;
        for (u32 b = f.FirstBlock; b < f.FirstBlock + f.NBlocks; b++) {
            EBlock blk = m.Block(b);
            this.A.Bind(this.BlockLabels.Get(b as usize));
            this.NextBlock = 0;
            if (b + 1 < f.FirstBlock + f.NBlocks) this.NextBlock = b + 1;
            this.BlockEnd = blk.FirstInst + blk.NInsts;
            for (u32 i = blk.FirstInst; i < blk.FirstInst + blk.NInsts; i++) {
                if (this.Opt && this.KeepInst.Len() > 0) this.Keep(m, i);
                else this.Inst(m, i);
            }
        }
    }

    // Instruction i with the registers of the values kept across it stored before and
    // loaded after.
    void Keep(ref this, in Module m, u32 i) {
        // the list is sorted by instruction, but blocks may come in any order
        usize lo = 0;
        usize hi = this.KeepInst.Len();
        while (lo < hi) {
            usize mid = (lo + hi) / 2;
            if (this.KeepInst.Get(mid) < i) lo = mid + 1;
            else hi = mid;
        }
        usize e = lo;
        while (e < this.KeepInst.Len() && this.KeepInst.Get(e) == i) e++;
        // while the call sets up its arguments, which may overwrite those registers, the
        // values are read from their slots
        List<u8> regs = List<u8>.New();
        for (usize j = lo; j < e; j++) {
            u32 k = this.KeepVal.Get(j);
            u8 r = this.Regs.Get(k as usize);
            regs.Push(r);
            this.A.Store(this.FB(), this.FD(this.VOff(this.FirstValue + k)), r, 8);
            this.Regs.Set(k as usize, NOREG);
        }
        this.Inst(m, i);
        for (usize j = lo; j < e; j++) {
            u32 k = this.KeepVal.Get(j);
            u8 r = regs.Get(j - lo);
            this.Regs.Set(k as usize, r);
            this.A.Load(r, this.FB(), this.FD(this.VOff(this.FirstValue + k)), 8, false);
        }
    }

    // sub rsp, frame, touching every page on the way down (a stack probe): the OS grows the
    // stack one guard page at a time, so a frame larger than a page must not skip one.
    // Stage 1 does the same.
    void ReserveFrame(ref this, u64 frame) {
        u64 rest = frame;
        if (rest >= 4096) {
            this.A.MovRI(R11, rest / 4096);
            u32 top = this.A.NewLabel();
            this.A.Bind(top);
            this.A.AluImm(5, RSP, 4096);
            this.A.Store(RSP, 0, R11, 8);
            this.A.AluImm(5, R11, 1);
            this.A.Jcc(CC_NE, top);
            rest = rest % 4096;
        }
        if (rest > 0) this.A.AluImm(5, RSP, rest as i32);
    }

    // -O2: the value of operand o if it is a constant of at most SMALL_BYTES, else
    // NOT_SMALL. Copies and zeroing that small are unrolled.
    u64 SmallConst(in this, in Module m, u32 o) {
        if (!this.Opt) return NOT_SMALL;
        EOp op = m.Op(o);
        if (op.Kind == OK_INT) {
            if (op.Int > SMALL_BYTES) return NOT_SMALL;
            return op.Int;
        }
        if (op.Kind != OK_VALUE) return NOT_SMALL;
        usize k = (op.Ref - this.FirstValue) as usize;
        if (this.RematKind.Get(k) != REMAT_CONST || this.RematImm.Get(k) > SMALL_BYTES) return NOT_SMALL;
        return this.RematImm.Get(k);
    }

    // Copies n bytes from [src + so] to [dst + do] through rax, widest moves first.
    void MoveBytes(ref this, u8 dst, i32 dOff, u8 src, i32 sOff, u64 n) {
        u64 at = 0;
        while (at < n) {
            u32 w = 8;
            while (at + w as u64 > n) w = w / 2;
            this.A.Load(RAX, src, sOff + at as i32, w, false);
            this.A.Store(dst, dOff + at as i32, RAX, w);
            at += w as u64;
        }
    }

    // Stores n zero bytes at [dst + off]; rax is zero.
    void ZeroBytes(ref this, u8 dst, i32 off, u64 n) {
        u64 at = 0;
        while (at < n) {
            u32 w = 8;
            while (at + w as u64 > n) w = w / 2;
            this.A.Store(dst, off + at as i32, RAX, w);
            at += w as u64;
        }
    }

    // -O2: which values are recomputed where used, and the registers of the others.
    void Plan(ref this, in Module m, u32 fi) {
        EFunc f = m.Func(fi);
        this.RematKind = List<u8>.New();
        this.RematImm = List<u64>.New();
        for (u32 k = 0; k < f.NValues; k++) {
            this.RematKind.Push(0);
            this.RematImm.Push(0);
        }
        for (u32 b = f.FirstBlock; b < f.FirstBlock + f.NBlocks; b++) {
            EBlock blk = m.Block(b);
            for (u32 i = blk.FirstInst; i < blk.FirstInst + blk.NInsts; i++) {
                EInst inst = m.Inst(i);
                if (inst.Result == 0) continue;
                usize k = (inst.Result - f.FirstValue) as usize;
                if (inst.Op == OP_CONST) {
                    this.RematKind.Set(k, REMAT_CONST);
                    this.RematImm.Set(k, inst.Imm);
                } else if (inst.Op == OP_SLOT) {
                    this.RematKind.Set(k, REMAT_FRAME);     // the offset is set with the frame
                } else if (inst.Op == 2) {
                    EOp rf = m.Op(inst.FirstOp);
                    u32 l = 0;
                    if (rf.Int == NAME_FUNC) l = this.FuncLabels.Get(rf.Ref as usize);
                    else l = this.GlobalLabels.Get(rf.Ref as usize);
                    this.RematKind.Set(k, REMAT_LABEL);
                    this.RematImm.Set(k, l as u64);
                }
            }
        }
        // how many operands use each value (a compare used once can fuse with its branch)
        this.Uses = List<u32>.New();
        for (u32 k = 0; k < f.NValues; k++) this.Uses.Push(0);
        for (u32 b = f.FirstBlock; b < f.FirstBlock + f.NBlocks; b++) {
            EBlock blk = m.Block(b);
            for (u32 i = blk.FirstInst; i < blk.FirstInst + blk.NInsts; i++) {
                EInst inst = m.Inst(i);
                for (u32 o = inst.FirstOp; o < inst.FirstOp + inst.NOps; o++) {
                    EOp op = m.Op(o);
                    if (op.Kind == OK_VALUE) {
                        usize k = (op.Ref - f.FirstValue) as usize;
                        this.Uses.Set(k, this.Uses.Get(k) + 1);
                    } else if (op.Kind == OK_TARGET) {
                        for (u32 a = 0; a < op.NArgs; a++) {
                            usize k = (m.Arg(op.Args + a) - f.FirstValue) as usize;
                            this.Uses.Set(k, this.Uses.Get(k) + 1);
                        }
                    }
                }
            }
        }
        List<bool> saved = List<bool>.New();
        List<u32> keepInst = List<u32>.New();
        List<u32> keepVal = List<u32>.New();
        this.Regs = AllocateRegs(m, fi, this.RematKind, ref saved, ref keepInst, ref keepVal);
        this.Saved = saved;
        // sorted by instruction (insertion: there are few)
        for (usize j = 1; j < keepInst.Len(); j++) {
            u32 ki = keepInst.Get(j);
            u32 kv = keepVal.Get(j);
            usize q = j;
            while (q > 0 && keepInst.Get(q - 1) > ki) {
                keepInst.Set(q, keepInst.Get(q - 1));
                keepVal.Set(q, keepVal.Get(q - 1));
                q--;
            }
            keepInst.Set(q, ki);
            keepVal.Set(q, kv);
        }
        this.KeepInst = keepInst;
        this.KeepVal = keepVal;
        // values kept in a register across calls have a stack slot too
        List<bool> slotToo = List<bool>.New();
        for (u32 k = 0; k < f.NValues; k++) slotToo.Push(false);
        for (usize j = 0; j < this.KeepVal.Len(); j++) slotToo.Set(this.KeepVal.Get(j) as usize, true);
        u32 n = 0;
        for (u32 r = 0; r < this.Saved.Len() as u32 && r < NSAVED; r++) {
            if (this.Saved.Get(r as usize)) n++;
        }
        this.SaveArea = 8 * n;
        // stack slots for the values that got no register and are not recomputed
        this.SpillIdx = List<u32>.New();
        this.NSpill = 0;
        for (u32 k = 0; k < f.NValues; k++) {
            bool stackParam = k < f.NParams && k >= NARGREGS;
            if (!stackParam && this.RematKind.Get(k as usize) == 0 && (this.Regs.Get(k as usize) == NOREG || slotToo.Get(k as usize))) {
                this.SpillIdx.Push(this.NSpill);
                this.NSpill++;
            } else {
                this.SpillIdx.Push(NO_SPILL);
            }
        }
    }

    // ------------------------------------------------------------------ data

    // The bytes of initializer i for type t, appended to the data.
    void Init(ref this, in Module m, u32 i, u32 t) {
        EInit init = m.Init(i);
        ETy ty = m.Ty(t);
        usize start = this.A.Data.Len();
        if (init.Kind == EI_BYTES) {
            this.A.Data.Append(TextStr(init.Bytes));
        } else if (init.Kind == EI_INT) {
            for (u32 k = 0; k < ty.Size; k++) this.A.DataByte((init.Int >> (8 * k) as u64 & 0xFF) as u8);
        } else if (init.Kind == EI_ADDR) {
            u64 named = m.Names.Get(TextStr(init.Bytes)) ?? 0;
            u32 idx = (named & 0xFFFFFFFF) as u32;
            if (named >> 32 == NAME_FUNC) this.A.DataAddr(this.FuncLabels.Get(idx as usize));
            else this.A.DataAddr(this.GlobalLabels.Get(idx as usize));
        } else if (init.Kind == EI_LIST) {
            u32 e = init.First;
            u32 k = 0;
            while (e != 0) {
                u32 et = ty.Elem;
                u64 at = k as u64 * m.Ty(ty.Elem).Size as u64;
                if (ty.Kind == EK_STRUCT) {
                    et = m.Field(ty.Fields + k);
                    at = m.FieldOffset(t, k);
                }
                while (this.A.Data.Len() < start + at as usize) this.A.DataByte(0);
                this.Init(m, e, et);
                e = m.Init(e).Next;
                k++;
            }
        }
        while (this.A.Data.Len() < start + ty.Size as usize) this.A.DataByte(0);
    }
}

const u16 OP_FIELDADDR_X = 44;
const u8 NO_SCALE = 0xFF;

// The SIB scale for an element of size bytes, as a shift; NO_SCALE if it has none.
u8 ScaleShift(u32 size) {
    if (size == 1) return 0;
    if (size == 2) return 1;
    if (size == 4) return 2;
    if (size == 8) return 3;
    return NO_SCALE;
}

// The condition code of integer compare op: true when the compare holds.
u8 CmpCC(u16 op, bool signed) {
    u8 cc = CC_E;
    if (op == 21) cc = CC_NE;
    if (op == 22) cc = CC_B;
    if (op == 23) cc = CC_BE;
    if (op == 24) cc = CC_A;
    if (op == 25) cc = CC_AE;
    if (signed && op == 22) cc = CC_L;
    if (signed && op == 23) cc = CC_LE;
    if (signed && op == 24) cc = CC_G;
    if (signed && op == 25) cc = CC_GE;
    return cc;
}

// Generates module m (verified and laid out) for target into a complete executable image.
// v in hexadecimal, 16 digits.
void AppendHex(ref string b, u64 v) {
    u32 shift = 64;
    while (shift > 0) {
        shift -= 4;
        u64 d = (v >> shift as u64) & 15;
        if (d < 10) b.AppendByte((48 + d) as u8);
        else b.AppendByte((87 + d) as u8);
    }
}

// The functions a program can reach: from the entry point's (__rt_init, __main, __rt_exit),
// the panic stubs' __rt_trap and the functions data points to, through every call and
// function address in a function reached.
List<bool> LiveFuncs(in Module m) {
    u32 nf = m.Funcs.Len() as u32;
    List<bool> live = List<bool>.New();
    for (u32 i = 0; i < nf; i++) live.Push(false);
    List<u32> work = List<u32>.New();
    List<str> roots = List<str>.New();
    roots.Push("__rt_init");
    roots.Push("__main");
    roots.Push("__rt_exit");
    roots.Push("__rt_trap");
    for (usize r = 0; r < roots.Len(); r++) {
        u64? named = m.Names.Get(roots.Get(r));
        if (named.IsSome() && named.Unwrap() >> 32 == NAME_FUNC) work.Push((named.Unwrap() & 0xFFFFFFFF) as u32);
    }
    for (usize k = 0; k < m.Inits.Len(); k++) {
        EInit init = m.Inits.AsSlice()[k];
        if (init.Kind != EI_ADDR) continue;
        u64? named = m.Names.Get(TextStr(init.Bytes));
        if (named.IsSome() && named.Unwrap() >> 32 == NAME_FUNC) work.Push((named.Unwrap() & 0xFFFFFFFF) as u32);
    }
    while (work.Len() > 0) {
        u32 fi = work.Pop().Unwrap();
        if (fi == 0 || fi >= nf || live.Get(fi as usize)) continue;
        live.Set(fi as usize, true);
        EFunc f = m.Func(fi);
        for (u32 b = f.FirstBlock; b < f.FirstBlock + f.NBlocks; b++) {
            EBlock blk = m.Block(b);
            for (u32 i = blk.FirstInst; i < blk.FirstInst + blk.NInsts; i++) {
                EInst inst = m.Inst(i);
                if (inst.Op == OP_CALL || inst.Op == 2) {
                    EOp rf = m.Op(inst.FirstOp);
                    if (inst.Op == OP_CALL || rf.Int == NAME_FUNC) work.Push(rf.Ref);
                }
            }
        }
    }
    return live;
}

// opt: -O2 code (registers and rematerialization) instead of -O0's. map, if wanted, gets
// a link map: each function's address and name, one per line, in address order.
public string GenModule(ref Module m, u32 target, bool opt, bool wantMap, ref string map) {
    Gen g = new Gen {
        A = Asm.New(), Target = target, FuncLabels = List<u32>.New(), GlobalLabels = List<u32>.New(),
        BlockLabels = List<u32>.New(), Traps = List<u32>.New(), Func = 0, FirstValue = 0, NParams = 0,
        Imports = new WinImports { Dir = 0, Iat = 0 }, Opt = opt, Regs = List<u8>.New(),
        RematKind = List<u8>.New(), RematImm = List<u64>.New(), Saved = List<bool>.New(), SaveArea = 0, FrameBias = 0, FrameSize = 0, SlotBytes = 0, RspDelta = 0,
        Uses = List<u32>.New(), SpillIdx = List<u32>.New(), KeepInst = List<u32>.New(), KeepVal = List<u32>.New(), NSpill = 0, NextBlock = 0, BlockEnd = 0, Fused = 0, FoldedField = 0, FoldedInst = 0,
        SpillV = 0, SpillReg = 0, SpillAt = 0
    };
    g.A.Short = opt;
    for (usize i = 0; i < m.Funcs.Len(); i++) g.FuncLabels.Push(0);
    for (usize i = 0; i < m.Globals.Len(); i++) g.GlobalLabels.Push(0);
    for (usize i = 0; i < m.Blocks.Len(); i++) g.BlockLabels.Push(0);
    for (u64 r = 0; r < PANIC_COUNT; r++) g.Traps.Push(0);
    for (u32 i = 1; i < m.Funcs.Len() as u32; i++) {
        u32 l = g.A.NewLabel();
        g.FuncLabels.Set(i as usize, l);
    }
    for (u32 i = 1; i < m.Blocks.Len() as u32; i++) {
        u32 l = g.A.NewLabel();
        g.BlockLabels.Set(i as usize, l);
    }
    for (u32 i = 1; i < m.Globals.Len() as u32; i++) {
        u32 l = g.A.NewLabel();
        g.GlobalLabels.Set(i as usize, l);
    }
    if (target == TARGET_WINDOWS) g.Imports = EmitImports(ref g.A);
    // Linux programs are position-independent: they relocate themselves first (PLAN D68)
    u32 data0 = 0;
    u32 relocs = 0;
    if (target == TARGET_LINUX) {
        data0 = g.A.NewLabel();
        relocs = g.A.NewLabel();
        g.A.RelocStub(data0, relocs);
    }
    // the entry point: __rt_init(initial stack pointer), __main(), __rt_exit(code)
    g.A.MovRR(RAX, RSP);
    g.A.AluImm(4, RSP, -16);
    g.A.AluImm(5, RSP, 16);
    if (opt) g.A.MovRR(ArgReg(0), RAX);
    else g.A.Store(RSP, 0, RAX, 8);
    u32 init = g.FuncLabels.Get(g.FuncNamed(m, "__rt_init") as usize);
    g.A.CallLabel(init);
    u32 main = g.FuncLabels.Get(g.FuncNamed(m, "__main") as usize);
    g.A.CallLabel(main);
    if (opt) g.A.MovRR(ArgReg(0), RAX);
    else g.A.Store(RSP, 0, RAX, 8);
    u32 exitFn = g.FuncLabels.Get(g.FuncNamed(m, "__rt_exit") as usize);
    g.A.CallLabel(exitFn);
    g.A.Ud2();
    // only the functions something can reach: inlining leaves many with no caller
    List<bool> live = LiveFuncs(m);
    for (u32 i = 1; i < m.Funcs.Len() as u32; i++) {
        if (live.Get(i as usize)) g.Func(ref m, i);
    }
    // the panic stubs: __rt_trap(reason)
    u32 trap = g.FuncLabels.Get(g.FuncNamed(m, "__rt_trap") as usize);
    for (u64 r = 0; r < PANIC_COUNT; r++) {
        u32 l = g.Traps.Get(r as usize);
        if (l == 0) continue;
        g.A.Bind(l);
        // a leaf function at -O2 may leave rsp unaligned: align it here
        if (opt) g.A.AluImm(4, RSP, -16);
        g.A.AluImm(5, RSP, 16);
        if (opt) {
            g.A.MovRI(ArgReg(0), r);
        } else {
            g.A.MovRI(RAX, r);
            g.A.Store(RSP, 0, RAX, 8);
        }
        g.A.CallLabel(trap);
        g.A.Ud2();
    }
    for (u32 i = 1; i < m.Globals.Len() as u32; i++) {
        EGlobal gl = m.Global(i);
        ETy gt = m.Ty(gl.Type);
        usize align = gt.Align as usize;
        if (align < 8) align = 8;
        g.A.DataAlign(align);
        g.A.BindData(g.GlobalLabels.Get(i as usize));
        g.Init(m, gl.Init, gl.Type);
    }
    if (wantMap) {
        u64 section = ELF_HEADERS;      // from the load address (position-independent)
        if (target == TARGET_WINDOWS) section = IMAGE_BASE + PE_SECTION_RVA;
        for (u32 i = 1; i < m.Funcs.Len() as u32; i++) {
            if (!live.Get(i as usize)) continue;
            AppendHex(ref map, section + g.A.LabelOffset(g.FuncLabels.Get(i as usize), 0));
            map.AppendByte(' ');
            map.Append(TextStr(m.Func(i).Name));
            map.AppendByte(10);
        }
    }
    return WriteImage(ref g.A, target, g.Imports, data0, relocs);
}
